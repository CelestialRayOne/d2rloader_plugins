#include <D2RLPlugin/resource.h>
#include <D2RLPlugin/version.h>
#include "resource_ids.h"

D2RL_PLUGIN_MANIFEST_RESOURCE_ID RCDATA { D2RL_PLUGIN_RESOURCE_DWORD(D2RL_PLUGIN_ABI_VERSION) }

// The string file (registered under data/local/lng/strings/d2rloader/<plugin id>/)
// and the default config written on first load.
MATERIAL_UPGRADE_STRINGS_ID        RCDATA "strings.json"
MATERIAL_UPGRADE_DEFAULT_CONFIG_ID RCDATA "celestialrayone.material-upgrade.toml"

1 VERSIONINFO
FILEVERSION 1,3,2,0
PRODUCTVERSION 1,3,2,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "CelestialRayOne"
      VALUE "FileDescription", "Material Upgrade: Shift + click upgrades and Alt + click downgrades stack-tab materials in place."
      VALUE "FileVersion", "1.3.2"
      VALUE "InternalName", "celestialrayone.material-upgrade"
      VALUE "OriginalFilename", "d2rl-celestialrayone-material-upgrade.dll"
      VALUE "ProductName", "Material Upgrade"
      VALUE "ProductVersion", "1.3.2"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
