D2RL_PLUGIN_MANIFEST_RESOURCE_ID RCDATA { D2RL_PLUGIN_RESOURCE_DWORD(D2RL_PLUGIN_ABI_VERSION) }

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "CelestialRayOne"
      VALUE "FileDescription", "Credits the kills and weapon-damage hits of listed monsters (assassin traps by default) to the player who owns them."
      VALUE "FileVersion", "1.0.0"
      VALUE "InternalName", "celestialrayone.trap-owner-credit"
      VALUE "OriginalFilename", "d2rl-celestialrayone-trap-owner-credit.dll"
      VALUE "ProductName", "Trap Owner Credit"
      VALUE "ProductVersion", "1.0.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
